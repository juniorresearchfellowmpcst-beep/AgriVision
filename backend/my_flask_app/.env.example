# AgriVision backend configuration.
#
# Copy to `.env` (gitignored) and fill in. Every value here has a default that
# works on a developer's laptop, so a fresh checkout runs with none of them —
# see docs/DEPLOYMENT.md for what production additionally requires.

# ── environment ──────────────────────────────────────────────────────────
# "development" or "production". Setting production turns on the boot checks
# below: the app refuses to start with development signing keys in place.
APP_ENV=development
PORT=5000
LOG_LEVEL=INFO
# JSON lines for a log aggregator; leave off for a human watching a terminal.
LOG_JSON=0

# ── secrets (REQUIRED when APP_ENV=production) ───────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing JWT_SECRET_KEY invalidates every issued token — users sign in again.
# SECRET_KEY=
# JWT_SECRET_KEY=
JWT_EXPIRES_DAYS=30

# ── database ─────────────────────────────────────────────────────────────
# Unset means a local SQLite file. On a container host that file is wiped on
# every redeploy, so production requires Postgres — or ALLOW_SQLITE=1 to say
# the box really does have a persistent disk.
# DATABASE_URL=postgresql://user:password@host:5432/agrivision
# ALLOW_SQLITE=0
# Off in production: manage the schema with `flask db upgrade` instead.
# AUTO_CREATE_TABLES=1

# ── network ──────────────────────────────────────────────────────────────
# Comma-separated allowlist; empty means any origin. Only affects the Flutter
# web build — the mobile app does not enforce CORS.
# CORS_ORIGINS=https://app.example.com
# Number of reverse proxies in front of this app. 1 behind Railway/nginx.
# LEAVE AT 0 when reached directly, or a client can forge its source address
# and hand itself a fresh rate-limit quota.
PROXY_COUNT=0
MAX_UPLOAD_MB=32

# ── live camera relay ────────────────────────────────────────────────────
# Each viewer holds one gunicorn worker thread; keep well under GUNICORN_THREADS.
LIVE_STREAM_MAX_VIEWERS=8
GUNICORN_THREADS=24

# ── who may call the API ─────────────────────────────────────────────────
# Off by default, and that is a product decision: on a closed field network the
# operator registers cameras and flies before anyone signs in, so most read and
# capture endpoints tolerate anonymous calls. Turn this ON for a backend
# reachable from the internet — every jwt_optional_lenient endpoint then
# answers 401 without a valid token.
REQUIRE_AUTH=0

# ── auth throttle ────────────────────────────────────────────────────────
# Attempts per IP per window, on the endpoints where guessing pays.
RATELIMIT_ENABLED=1
RATELIMIT_WINDOW_S=300
RATELIMIT_SIGNIN=10
RATELIMIT_SIGNUP=5
RATELIMIT_PASSWORD_RESET=5

# ── flight link ──────────────────────────────────────────────────────────
# "udpin:" means WE listen — what a SITL sim / MAVProxy --out streams into.
# Real hardware over a USB radio is e.g. COM5 or /dev/ttyUSB0.
MAVLINK_URL=udpin:0.0.0.0:14550
# 254 if Mission Planner or QGC watches the same vehicle (they default to 255,
# and two ground stations sharing an id corrupt mission uploads).
MAVLINK_SOURCE_SYSTEM=255

# ── password reset email ─────────────────────────────────────────────────
# With MAIL_* unset the reset OTP is returned in the response as debug_otp,
# which is a DEVELOPMENT convenience and must not be relied on in production.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=

# ── crop advisor ("More information") ────────────────────────────────────
# Google Gemini, used only when the farmer taps "More information" on a scan:
# the photo and the app's own diagnosis are sent up so they can ask follow-up
# questions about it. OPTIONAL, and off unless set — every other feature works
# on a field network with no internet, and this is the one that does not.
# With no key the endpoints answer 503 and the app hides the button.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#
# Leave GEMINI_MODEL unset unless you have a reason. The default is the alias
# `gemini-flash-latest`, which follows whatever the current flash model is. A
# pinned version rots: `gemini-2.5-flash` was the default here until Google
# retired it for new keys, and the feature answered 404 until someone noticed.
# GEMINI_MODEL=gemini-flash-latest

# ── spray hardware ───────────────────────────────────────────────────────
# How the pump is actuated on this rig. Only 'servo' can fly a genuinely
# variable rate; the other two are on/off switches. See docs/TARGETED_SPRAY.md.
SPRAY_MECHANISM=sprayer
SPRAY_SWATH_M=3.0
SPRAY_ALTITUDE_M=3.0
SPRAY_SPEED_MS=3.0

# ── google sign-in ───────────────────────────────────────────────────────
# OAuth 2.0 *Web application* client id; must match the app's GOOGLE_WEB_CLIENT_ID.
# GOOGLE_CLIENT_ID=
