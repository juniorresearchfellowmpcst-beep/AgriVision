# Local backend configuration. Not committed — copy and adjust per machine.

# ── MAVLink link to the drone / simulator ─────────────────────────────────
# Default endpoint for POST /api/mavlink/connect when no "url" is supplied.
#
# ArduPilot SITL exposes three MAVLink TCP ports: 5760, 5762, 5763. Mission
# Planner takes 5760 when it launches the simulation, so 5762 is free for us —
# and connecting there needs no forwarding set up in Mission Planner at all.
# Verified working against a running Mission Planner SITL on this machine.
MAVLINK_URL=tcp:127.0.0.1:5762

#   Other endpoints, depending on where the vehicle is:
#   tcp:127.0.0.1:5763    the other spare SITL port, if 5762 is taken
#   udpin:0.0.0.0:14550   we listen on every interface — for a simulator on a
#                         SECOND laptop that forwards to us, or MAVProxy --out.
#                         Do not use this while Mission Planner runs on this
#                         PC: it already holds 14550 and we cannot bind it too.
#   tcp:127.0.0.1:5760    SITL's first port — only free when Mission Planner
#                         is NOT attached
#   COM5 / /dev/ttyUSB0   real telemetry radio (send "baud" with the request)

# Our address on the MAVLink network. Mission Planner and QGroundControl also
# default to 255 — if one of them is watching the same vehicle, set this to
# 254 so mission-upload replies aren't answered by the wrong ground station.
MAVLINK_SOURCE_SYSTEM=254
