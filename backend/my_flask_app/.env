# Local backend configuration. Not committed — copy and adjust per machine.

# ── MAVLink link to the drone / simulator ─────────────────────────────────
# Default endpoint for POST /api/mavlink/connect when no "url" is supplied.
#   udpin:0.0.0.0:14550   we listen on every interface — SITL / Mission
#                         Planner / MAVProxy --out, on this PC or another one
#                         on the LAN. This is the one to use for a simulator
#                         running on a second laptop.
#   udpin:127.0.0.1:14550 listen on loopback only (same-PC simulator)
#   tcp:127.0.0.1:5760    connect straight to ArduPilot SITL (no MAVProxy)
#   COM5 / /dev/ttyUSB0   real telemetry radio (send "baud" with the request)
MAVLINK_URL=udpin:0.0.0.0:14550

# Our address on the MAVLink network. Mission Planner and QGroundControl also
# default to 255 — if one of them is watching the same vehicle, set this to
# 254 so mission-upload replies aren't answered by the wrong ground station.
# MAVLINK_SOURCE_SYSTEM=254
