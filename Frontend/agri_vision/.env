# Template only — the app loads assets/.env at runtime (see bootstrap.dart),
# not this file. Copy this to assets/.env and set BASE_URL there.
#
# BASE_URL is the single place to point the app at the Flask backend:
#   - Web / desktop / Android emulator on this PC:  http://127.0.0.1:5000
#   - Physical Android device on the same Wi-Fi:     http://<your-PC-LAN-IP>:5000
BASE_URL=http://127.0.0.1:5000

# Google Sign-In: the OAuth **Web application** client ID (Google Cloud →
# Credentials). Put the same value in backend/my_flask_app/.env as
# GOOGLE_CLIENT_ID. Leave GOOGLE_SERVER_CLIENT_ID blank unless your mobile
# serverClientId differs from the web id (it normally shouldn't).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
